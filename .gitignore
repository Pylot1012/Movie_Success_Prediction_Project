# ── Python ────────────────────────────────────────────────────────────
venv/
env/
ENV/
.venv/
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Data files — EXCEPT the dashboard CSV needed by the Streamlit app ─
*.xlsx
*.xls
*.h5
*.hdf5
*.feather
*.parquet

# Large original dataset — do NOT commit
data/movie_metadata.csv

# Trained model artifacts — do NOT commit (model is retrained on startup)
Deployment/model.pkl
Deployment/scaler.pkl

# Allow the processed dashboard CSV — the app NEEDS this
!Deployment/movie_dashboard_data.csv

# ── Images ────────────────────────────────────────────────────────────
# (charts are generated in code, so PNGs are not needed in the repo)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.svg
# Allow the Tableau dashboard screenshot if present
!Dashboard/Tableau/dashboard_screenshot.png

# ── Tableau ───────────────────────────────────────────────────────────
*.tde
*.hyper

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Environment variables ─────────────────────────────────────────────
.env
.env.*

# ── Streamlit ─────────────────────────────────────────────────────────
